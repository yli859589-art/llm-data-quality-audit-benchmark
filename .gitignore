# Large local-only data/checkpoint artifacts.
# These are preserved in the Desktop release bundle, but GitHub should carry
# code, configs, manifests, reports, tables, and lightweight metrics rather than
# raw corpora or binary model checkpoints.
artifacts/localmax_data/**/*.jsonl
artifacts/localmax_v2_data/**/shards/*.jsonl.gz
artifacts/localmax_training/**/*.pt
artifacts/localmax_training_strengthened/**/*.pt
artifacts/localmax_v2_training/**/*.pt
artifacts/localmax_ccfc_training/**/*.pt
